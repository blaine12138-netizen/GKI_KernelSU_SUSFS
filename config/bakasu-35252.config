# ==================== BakaSU / SUSFS 固定提交（35252） ====================
# 对应 BakaSU versionCode 35252（= 30000 + commitCount 4552 + 700）
# commitCount 用 git rev-list --count HEAD 得到；HEAD 即 35252 时无需固定也能命中，
# 但上游一推进版本号就变，所以这里写死最稳。
#
# 放进你的仓库 config/ 目录，名字按你的习惯取，例如 config/config
# 若你的 build.yml 里 BakaSU 分支没有读 bakasu= 的逻辑，把 ci/kpm-patch-step.yml
# 旁边的说明照抄一段到「添加 KernelSU」步骤（见 INTEGRATE.md 第 3 节）。

custom=true

# SUSFS 各分支 commit（susfs4ksu）
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=c51cd8aad3f7e2f8c48bc3bda88cc68cf7d82895
gki-android16-6.12=

# SukiSU commit（SukiSU 变体才读）
sukisu=

# BakaSU commit —— 35252
bakasu=d5e9e025b8b49155f8014684d64c91742b465f65
